diff --git a/build.sh b/build.sh
--- a/build.sh
+++ b/build.sh
@@ -187,6 +187,12 @@
 # Lunch-time!
 echo -e "${CLR_BLD_BLU}Lunching $DEVICE${CLR_RST} ${CLR_CYA}(Including dependencies sync)${CLR_RST}"
 echo -e ""
-lunch "aospa_$DEVICE-$BUILD_TYPE"
+LUNCH_TARGET="aospa_$DEVICE-cp2a-$BUILD_TYPE"
+# Failed lunch can still return success after writing .leftovers.
+unset TARGET_RELEASE
+if ! lunch "$LUNCH_TARGET" || [[ "${TARGET_RELEASE:-}" != cp2a ]]; then
+    echo "${CLR_BLD_RED}Lunch failed for $LUNCH_TARGET${CLR_RST}" >&2
+    exit 1
+fi
 AOSPA_VERSION="$(get_build_var AOSPA_VERSION)"
 AOSPA_BUILD_VARIANT="$(get_build_var AOSPA_BUILD_VARIANT)"
